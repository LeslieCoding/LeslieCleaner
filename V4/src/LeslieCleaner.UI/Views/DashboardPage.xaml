<UserControl x:Class="LeslieCleaner.UI.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LeslieCleaner.UI.Controls"
             xmlns:vm="clr-namespace:LeslieCleaner.UI.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 健康评分卡 -->
        <Border Grid.Row="0" Style="{DynamicResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Width="120" Height="120" VerticalAlignment="Center">
                    <controls:ScoreRing Value="{Binding HealthScore}" StrokeThickness="10"
                                        RingBrush="{DynamicResource PrimaryBrush}"
                                        TrackBrush="{DynamicResource TrackBrush}" />
                    <TextBlock Text="{Binding HealthScore}" FontSize="34" FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}">
                        <Run Text="系统健康评分：" /><Run Text="{Binding ScoreGrade}" />
                    </TextBlock>
                    <TextBlock Text="{Binding LastScanText}" Style="{DynamicResource SecondaryText}" Margin="0,6,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <Button Style="{DynamicResource PrimaryButton}" Width="180" Content="刷新评估"
                            Command="{Binding RefreshCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 四卡片 -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,16,0,0">
            <Border Style="{DynamicResource Card}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="存储空间" Style="{DynamicResource SecondaryText}" />
                    <TextBlock Text="{Binding StorageCard.Value}" FontSize="22" FontWeight="Bold" Margin="0,6,0,2"
                               Foreground="{Binding StorageCard.StateBrushKey, Converter={StaticResource RiskToBrush}}" />
                    <TextBlock Text="系统盘剩余" Style="{DynamicResource SecondaryText}" />
                </StackPanel>
            </Border>
            <Border Style="{DynamicResource Card}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="隐私风险" Style="{DynamicResource SecondaryText}" />
                    <TextBlock Text="{Binding PrivacyCard.Value}" FontSize="22" FontWeight="Bold" Margin="0,6,0,2"
                               Foreground="{Binding PrivacyCard.StateBrushKey, Converter={StaticResource RiskToBrush}}" />
                    <TextBlock Text="八类痕迹探测" Style="{DynamicResource SecondaryText}" />
                </StackPanel>
            </Border>
            <Border Style="{DynamicResource Card}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="启动项" Style="{DynamicResource SecondaryText}" />
                    <TextBlock Text="{Binding StartupCard.Value}" FontSize="22" FontWeight="Bold" Margin="0,6,0,2"
                               Foreground="{Binding StartupCard.StateBrushKey, Converter={StaticResource RiskToBrush}}" />
                    <TextBlock Text="高影响启动项" Style="{DynamicResource SecondaryText}" />
                </StackPanel>
            </Border>
            <Border Style="{DynamicResource Card}">
                <StackPanel>
                    <TextBlock Text="系统性能" Style="{DynamicResource SecondaryText}" />
                    <TextBlock Text="{Binding PerformanceCard.Value}" FontSize="22" FontWeight="Bold" Margin="0,6,0,2"
                               Foreground="{Binding PerformanceCard.StateBrushKey, Converter={StaticResource RiskToBrush}}" />
                    <TextBlock Text="综合评估" Style="{DynamicResource SecondaryText}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- 收藏区 -->
        <Border Grid.Row="2" Style="{DynamicResource Card}" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="收藏" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}" Margin="0,0,0,12" />
                <ItemsControl ItemsSource="{Binding Favorites}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBlock Text="{Binding Title}"
                                           Foreground="{DynamicResource TextBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- 最近项目 -->
        <Border Grid.Row="3" Style="{DynamicResource Card}" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="最近" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}" Margin="0,0,0,12" />
                <ItemsControl ItemsSource="{Binding RecentItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="5" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBlock Text="{Binding Title}"
                                           Foreground="{DynamicResource TextBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- 快捷操作 -->
        <Border Grid.Row="4" Style="{DynamicResource Card}" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="快捷操作" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}" Margin="0,0,0,12" />
                <UniformGrid Columns="6">
                    <Button Style="{DynamicResource ToolButton}" Height="56"
                            Command="{Binding QuickActionCommand}" CommandParameter="Smart Scan">
                        <StackPanel>
                            <controls:LineIcon Kind="zap" Width="22" Height="22" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="深度清理" Style="{DynamicResource SecondaryText}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{DynamicResource ToolButton}" Height="56"
                            Command="{Binding QuickActionCommand}" CommandParameter="注册表清理">
                        <StackPanel>
                            <controls:LineIcon Kind="shield" Width="22" Height="22" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="注册表清理" Style="{DynamicResource SecondaryText}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{DynamicResource ToolButton}" Height="56"
                            Command="{Binding QuickActionCommand}" CommandParameter="智能卸载">
                        <StackPanel>
                            <controls:LineIcon Kind="trash" Width="22" Height="22" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="智能卸载" Style="{DynamicResource SecondaryText}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{DynamicResource ToolButton}" Height="56"
                            Command="{Binding QuickActionCommand}" CommandParameter="启动项管理">
                        <StackPanel>
                            <controls:LineIcon Kind="rocket" Width="22" Height="22" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="启动项管理" Style="{DynamicResource SecondaryText}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{DynamicResource ToolButton}" Height="56"
                            Command="{Binding QuickActionCommand}" CommandParameter="隐私保护">
                        <StackPanel>
                            <controls:LineIcon Kind="lock" Width="22" Height="22" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="隐私保护" Style="{DynamicResource SecondaryText}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{DynamicResource ToolButton}" Height="56"
                            Command="{Binding QuickActionCommand}" CommandParameter="文件粉碎">
                        <StackPanel>
                            <controls:LineIcon Kind="scissors" Width="22" Height="22" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="文件粉碎" Style="{DynamicResource SecondaryText}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                    </Button>
                </UniformGrid>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="5" Style="{DynamicResource SecondaryText}" Margin="0,16,0,0"
                   Text="AI Powered Windows Optimization Platform — 全部操作可回滚：删除进隔离区，注册表先备份" />
    </Grid>
</UserControl>
