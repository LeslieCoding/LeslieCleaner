<UserControl x:Class="LeslieCleaner.UI.Views.PrivacyPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LeslieCleaner.UI.Controls"
             xmlns:vm="clr-namespace:LeslieCleaner.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PrivacyViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{DynamicResource Card}" Margin="0,0,0,16">
            <Grid>
                <StackPanel>
                    <TextBlock Text="隐私保护" Style="{DynamicResource PageTitle}" FontSize="18" />
                    <TextBlock Text="{Binding StatusText}" Style="{DynamicResource SecondaryText}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{DynamicResource PrimaryButton}" Content="扫描"
                            Command="{Binding ScanCommand}" Margin="0,0,8,0" />
                    <Button Style="{DynamicResource DangerButton}" Content="一键清理"
                            Command="{Binding CleanCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 批量选择头：三态全选 + 取消全选/反选 + 勾选批量栏 -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox Style="{DynamicResource CheckBoxFluent}" IsThreeState="True"
                          IsChecked="{Binding Selection.SelectAllState, Mode=OneWay}"
                          Click="OnSelectAllClick" VerticalAlignment="Center" />
                <TextBlock Text="全选" Style="{DynamicResource BodyText}" VerticalAlignment="Center" Margin="4,0,12,0" />
                <Button Style="{DynamicResource ToolButton}" Content="取消全选"
                        Command="{Binding Selection.DeselectAllCommand}" Margin="0,0,6,0" />
                <Button Style="{DynamicResource ToolButton}" Content="反选"
                        Command="{Binding Selection.InvertSelectionCommand}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Visibility="{Binding Selection.HasChecked, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding Selection.CheckedCount, StringFormat=已选 {0} 类}"
                           Style="{DynamicResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <Button Style="{DynamicResource DangerButton}" Content="批量清理"
                        Command="{Binding CleanCommand}" />
            </StackPanel>
        </Grid>

        <UniformGrid Grid.Row="2" Columns="2">
            <ItemsControl ItemsSource="{Binding Categories}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{DynamicResource Card}" Margin="0,0,8,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked}" Style="{DynamicResource CheckBoxFluent}" />
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding DisplayName}" Style="{DynamicResource BodyText}" FontWeight="SemiBold" />
                                    <TextBlock Style="{DynamicResource SecondaryText}">
                                        <Run Text="{Binding ItemCount, StringFormat={}{0} 项}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding SizeBytes, Converter={StaticResource BytesToString}}" />
                                    </TextBlock>
                                </StackPanel>
                                <controls:LineIcon Grid.Column="2" Kind="lock" Width="18" Height="18" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </UniformGrid>
    </Grid>
</UserControl>
