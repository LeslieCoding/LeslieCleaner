<UserControl x:Class="LeslieCleaner.UI.Views.ToolboxPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LeslieCleaner.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ToolboxViewModel}">
    <ScrollViewer>
        <StackPanel>
            <Border Style="{DynamicResource Card}" Margin="0,0,0,16">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="工具箱" Style="{DynamicResource PageTitle}" FontSize="18" />
                        <TextBlock Text="{Binding StatusText}" Style="{DynamicResource SecondaryText}" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{DynamicResource SecondaryButton}" Content="创建系统还原点"
                                Command="{Binding CreateRestorePointCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <UniformGrid Columns="2">
                <!-- 隔离区 -->
                <Border Style="{DynamicResource Card}" Margin="0,0,8,16">
                    <StackPanel>
                        <Grid>
                            <TextBlock Style="{DynamicResource BodyText}" FontWeight="SemiBold">
                                <Run Text="隔离区管理" /><Run Text="（" /><Run Text="{Binding QuarantineSummary}" /><Run Text="）" />
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{DynamicResource ToolButton}" Content="刷新"
                                        Command="{Binding LoadQuarantineCommand}" />
                                <Button Style="{DynamicResource ToolButton}" Content="清理过期"
                                        Command="{Binding PurgeExpiredCommand}" />
                            </StackPanel>
                        </Grid>
                        <!-- 隔离区批量选择头 -->
                        <Grid Margin="0,6,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox Style="{DynamicResource CheckBoxFluent}" IsThreeState="True"
                                          IsChecked="{Binding QuarantineSelection.SelectAllState, Mode=OneWay}"
                                          Click="OnQuarantineSelectAllClick" VerticalAlignment="Center" />
                                <TextBlock Text="全选" Style="{DynamicResource BodyText}" VerticalAlignment="Center" Margin="4,0,12,0" />
                                <Button Style="{DynamicResource ToolButton}" Content="反选"
                                        Command="{Binding QuarantineSelection.InvertSelectionCommand}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Visibility="{Binding QuarantineSelection.HasChecked, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding QuarantineSelection.CheckedCount, StringFormat=已选 {0} 项}"
                                           Style="{DynamicResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <Button Style="{DynamicResource SecondaryButton}" Content="批量还原"
                                        Command="{Binding RestoreSelectedQuarantineCommand}" />
                            </StackPanel>
                        </Grid>
                        <ScrollViewer MaxHeight="260" Margin="0,8,0,0">
                            <ListBox ItemsSource="{Binding QuarantineEntries}" Style="{DynamicResource FluentListBox}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked}" Style="{DynamicResource CheckBoxFluent}"
                                                      VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Entry.OriginalPath}" Style="{DynamicResource BodyText}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Style="{DynamicResource SecondaryText}">
                                                    <Run Text="{Binding Entry.SizeBytes, Converter={StaticResource BytesToString}}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding Entry.QuarantinedUtc, StringFormat={}{0:MM-dd HH:mm}}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Grid.Column="2" Style="{DynamicResource ToolButton}" Content="还原"
                                                    Command="{Binding DataContext.RestoreQuarantineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- 注册表备份 -->
                <Border Style="{DynamicResource Card}" Margin="8,0,0,16">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="注册表备份恢复" Style="{DynamicResource BodyText}" FontWeight="SemiBold" />
                            <Button HorizontalAlignment="Right" Style="{DynamicResource ToolButton}" Content="刷新"
                                    Command="{Binding LoadBackupsCommand}" />
                        </Grid>
                        <ScrollViewer MaxHeight="260" Margin="0,8,0,0">
                            <ListBox ItemsSource="{Binding Backups}" Style="{DynamicResource FluentListBox}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding RegistryKeyPath}" Style="{DynamicResource BodyText}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding CreatedUtc, StringFormat={}{0:MM-dd HH:mm}}"
                                                           Style="{DynamicResource SecondaryText}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Style="{DynamicResource ToolButton}" Content="恢复"
                                                    Command="{Binding DataContext.RestoreBackupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- 服务管理 -->
                <Border Style="{DynamicResource Card}" Margin="0,0,8,0">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="服务管理（核心服务黑名单保护）" Style="{DynamicResource BodyText}" FontWeight="SemiBold" />
                            <Button HorizontalAlignment="Right" Style="{DynamicResource ToolButton}" Content="枚举服务"
                                    Command="{Binding LoadServicesCommand}" />
                        </Grid>
                        <!-- 服务批量选择头 -->
                        <Grid Margin="0,6,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox Style="{DynamicResource CheckBoxFluent}" IsThreeState="True"
                                          IsChecked="{Binding ServiceSelection.SelectAllState, Mode=OneWay}"
                                          Click="OnServiceSelectAllClick" VerticalAlignment="Center" />
                                <TextBlock Text="全选" Style="{DynamicResource BodyText}" VerticalAlignment="Center" Margin="4,0,12,0" />
                                <Button Style="{DynamicResource ToolButton}" Content="反选"
                                        Command="{Binding ServiceSelection.InvertSelectionCommand}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Visibility="{Binding ServiceSelection.HasChecked, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding ServiceSelection.CheckedCount, StringFormat=已选 {0} 项}"
                                           Style="{DynamicResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <Button Style="{DynamicResource SecondaryButton}" Content="批量启动"
                                        Command="{Binding BatchControlServicesCommand}" CommandParameter="start" Margin="0,0,6,0" />
                                <Button Style="{DynamicResource SecondaryButton}" Content="批量停止"
                                        Command="{Binding BatchControlServicesCommand}" CommandParameter="stop" />
                            </StackPanel>
                        </Grid>
                        <ScrollViewer MaxHeight="220" Margin="0,8,0,0">
                            <ListBox ItemsSource="{Binding Services}" Style="{DynamicResource FluentListBox}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked}" Style="{DynamicResource CheckBoxFluent}"
                                                      VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding Item.Name}" Style="{DynamicResource BodyText}"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding Item.Location}"
                                                       Style="{DynamicResource SecondaryText}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="160" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- 维护计划 -->
                <Border Style="{DynamicResource Card}" Margin="8,0,0,0">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="计划任务维护" Style="{DynamicResource BodyText}" FontWeight="SemiBold" />
                            <Button HorizontalAlignment="Right" Style="{DynamicResource ToolButton}" Content="刷新"
                                    Command="{Binding LoadPlansCommand}" />
                        </Grid>
                        <ListBox ItemsSource="{Binding Plans}" Margin="0,8,0,0" Style="{DynamicResource FluentListBox}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4">
                                        <TextBlock Style="{DynamicResource BodyText}">
                                            <Run Text="{Binding Name}" />
                                            <Run Text="（每 " /><Run Text="{Binding IntervalDays}" /><Run Text=" 天）" />
                                        </TextBlock>
                                        <TextBlock Style="{DynamicResource SecondaryText}">
                                            <Run Text="模块：" /><Run Text="{Binding ModuleIds, StringFormat={}{0}}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ListBox>
                        <TextBlock Style="{DynamicResource SecondaryText}" Margin="0,8,0,0"
                                   Text="在 设置 → 维护计划 中创建自动维护计划；系统计划任务注册需要管理员权限。" />
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
