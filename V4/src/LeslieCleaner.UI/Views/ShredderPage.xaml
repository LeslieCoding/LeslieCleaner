<UserControl x:Class="LeslieCleaner.UI.Views.ShredderPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LeslieCleaner.UI.Controls"
             xmlns:vm="clr-namespace:LeslieCleaner.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ShredderViewModel}"
             AllowDrop="True"
             DragOver="OnDragOver" Drop="OnDrop">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{DynamicResource Card}" Margin="0,0,0,16">
            <Grid>
                <StackPanel>
                    <TextBlock Text="文件粉碎" Style="{DynamicResource PageTitle}" FontSize="18" />
                    <TextBlock Text="{Binding SsdHint}" Foreground="{DynamicResource WarningBrush}" Margin="0,4,0,0" FontSize="12" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ComboBox Width="180" Height="36" VerticalContentAlignment="Center"
                              ItemsSource="{Binding Methods}" SelectedItem="{Binding SelectedMethod}" />
                    <Button Style="{DynamicResource SecondaryButton}" Content="暂停/继续"
                            Command="{Binding TogglePauseCommand}" Margin="8,0" />
                    <Button Style="{DynamicResource DangerButton}" Content="开始粉碎"
                            Command="{Binding StartCommand}" />
                    <Button Style="{DynamicResource ToolButton}" Content="取消"
                            Command="{Binding CancelCommand}" Margin="8,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="2"
                CornerRadius="10" Padding="32" Margin="0,0,0,16" Background="Transparent"
                x:Name="DropZone">
            <StackPanel>
                <controls:LineIcon Kind="scissors" Width="28" Height="28" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="拖拽文件或文件夹到此处" Style="{DynamicResource BodyText}"
                           HorizontalAlignment="Center" Margin="0,8,0,0" />
                <TextBlock Text="{Binding StatusText}" Style="{DynamicResource SecondaryText}"
                           HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{DynamicResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{Binding CurrentFile}" Style="{DynamicResource SecondaryText}"
                           TextTrimming="CharacterEllipsis" />
                <ProgressBar Grid.Row="1" Style="{DynamicResource FluentProgressBar}"
                             Value="{Binding ProgressPercent}" Maximum="100" Margin="0,6,0,8" />

                <!-- 批量选择头：三态全选 + 取消全选/反选 + 勾选批量栏 -->
                <Grid Grid.Row="2" Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox Style="{DynamicResource CheckBoxFluent}" IsThreeState="True"
                                  IsChecked="{Binding Selection.SelectAllState, Mode=OneWay}"
                                  Click="OnSelectAllClick" VerticalAlignment="Center" />
                        <TextBlock Text="全选" Style="{DynamicResource BodyText}" VerticalAlignment="Center" Margin="4,0,12,0" />
                        <Button Style="{DynamicResource ToolButton}" Content="取消全选"
                                Command="{Binding Selection.DeselectAllCommand}" Margin="0,0,6,0" />
                        <Button Style="{DynamicResource ToolButton}" Content="反选"
                                Command="{Binding Selection.InvertSelectionCommand}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Visibility="{Binding Selection.HasChecked, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding Selection.CheckedCount, StringFormat=已选 {0} 项}"
                                   Style="{DynamicResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Button Style="{DynamicResource SecondaryButton}" Content="批量移除出队列"
                                Command="{Binding RemoveSelectedCommand}" />
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="3">
                    <ItemsControl ItemsSource="{Binding Tasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked}" Style="{DynamicResource CheckBoxFluent}"
                                              VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding Task.Path}" Style="{DynamicResource BodyText}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding Task.ProcessedFiles, StringFormat={}{0} 个}"
                                               Style="{DynamicResource SecondaryText}" TextAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding Task.Status}"
                                               Foreground="{DynamicResource PrimaryBrush}" TextAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
