<UserControl x:Class="LeslieCleaner.UI.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LeslieCleaner.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">
    <ScrollViewer>
        <StackPanel MaxWidth="720">
            <Border Style="{DynamicResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="主题" Style="{DynamicResource PageTitle}" FontSize="16" />
                    <ComboBox Height="40" Margin="0,10,0,0" VerticalContentAlignment="Center"
                              SelectedIndex="{Binding SelectedThemeIndex}">
                        <ComboBoxItem Content="浅色" />
                        <ComboBoxItem Content="深色" />
                        <ComboBoxItem Content="跟随系统" />
                    </ComboBox>
                    <TextBlock Text="切换即时生效；跟随系统监听 Windows 主题变化。" Style="{DynamicResource SecondaryText}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{DynamicResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="常规" Style="{DynamicResource PageTitle}" FontSize="16" />
                    <Grid Margin="0,10,0,0">
                        <TextBlock Text="开机自动启动" Style="{DynamicResource BodyText}" VerticalAlignment="Center" />
                        <ToggleButton HorizontalAlignment="Right" Style="{DynamicResource ToggleSwitch}"
                                      IsChecked="{Binding LaunchAtStartup}" />
                    </Grid>
                    <TextBlock Text="语言：简体中文（默认）" Style="{DynamicResource SecondaryText}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{DynamicResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="清理设置" Style="{DynamicResource PageTitle}" FontSize="16" />
                    <Grid Margin="0,10,0,0">
                        <TextBlock Text="隔离区保留天数" Style="{DynamicResource BodyText}" VerticalAlignment="Center" />
                        <TextBox HorizontalAlignment="Right" Style="{DynamicResource InputBox}" Width="100"
                                 Text="{Binding RetentionDays}" />
                    </Grid>
                    <TextBlock Text="浏览器 Cookie 白名单（每行一个域名，清理时保留登录状态）"
                               Style="{DynamicResource SecondaryText}" Margin="0,10,0,6" />
                    <TextBox AcceptsReturn="True" Height="120" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}"
                             BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="8"
                             Text="{Binding CookieWhitelistText}" />
                    <Button Style="{DynamicResource PrimaryButton}" Content="保存清理设置" Width="180"
                            HorizontalAlignment="Left" Command="{Binding SaveCleanupSettingsCommand}" Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{DynamicResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="维护计划" Style="{DynamicResource PageTitle}" FontSize="16" />
                        <Button HorizontalAlignment="Right" Style="{DynamicResource SecondaryButton}"
                                Content="创建每周自动维护" Command="{Binding AddWeeklyPlanCommand}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Plans}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{DynamicResource BodyText}" Margin="0,3">
                                    <Run Text="{Binding Name}" />
                                    <Run Text="（每 " /><Run Text="{Binding IntervalDays}" /><Run Text=" 天）" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{DynamicResource Card}">
                <StackPanel>
                    <TextBlock Text="关于" Style="{DynamicResource PageTitle}" FontSize="16" />
                    <TextBlock Text="{Binding AppVersion}" Style="{DynamicResource BodyText}" Margin="0,8,0,0" />
                    <TextBlock Text="AI Powered Windows Optimization Platform" Style="{DynamicResource SecondaryText}" />
                    <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource SuccessBrush}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
