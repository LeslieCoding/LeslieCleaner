<UserControl x:Class="LeslieCleaner.UI.Views.StartupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LeslieCleaner.UI.Controls"
             xmlns:vm="clr-namespace:LeslieCleaner.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:StartupViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ 顶部操作栏 ============ -->
        <Border Grid.Row="0" Style="{DynamicResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <StackPanel>
                    <TextBlock Text="启动项管理" Style="{DynamicResource PageTitle}" FontSize="18" />
                    <TextBlock Text="{Binding StatusText}" Style="{DynamicResource SecondaryText}" Margin="0,4,0,0"
                               TextWrapping="Wrap" MaxWidth="520" AutomationProperties.LiveSetting="Assertive" />
                    <Button Style="{DynamicResource SecondaryButton}" Content="以管理员身份重新启动并重试"
                            Command="{Binding RestartAsAdministratorCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"
                            AutomationProperties.Name="以管理员身份重新启动整个应用并重试启动项操作"
                            Visibility="{Binding HasElevationRequired, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <WrapPanel HorizontalAlignment="Left" Margin="0,12,0,0">
                    <TextBox Style="{DynamicResource InputBox}" Width="180"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="搜索名称/发布商" />
                    <ComboBox Width="110" Height="36" Margin="8,0" VerticalContentAlignment="Center"
                              SelectedIndex="{Binding SelectedSortIndex}" ToolTip="排序">
                        <ComboBoxItem Content="默认排序" />
                        <ComboBoxItem Content="按影响排序" />
                        <ComboBoxItem Content="按大小排序" />
                    </ComboBox>
                    <Button Style="{DynamicResource SecondaryButton}" Content="批量禁用"
                            Command="{Binding DisableSelectedCommand}" Margin="0,0,8,0" />
                    <Button Style="{DynamicResource SecondaryButton}" Content="批量启用"
                            Command="{Binding EnableSelectedCommand}" Margin="0,0,8,0" />
                    <Button Style="{DynamicResource SecondaryButton}" Content="刷新"
                            Command="{Binding LoadCommand}" Margin="0,0,8,0" />
                    <Button Style="{DynamicResource SecondaryButton}" Content="深度验证"
                            Command="{Binding AnalyzeDetailsCommand}" Margin="0,0,8,0"
                            ToolTip="验证签名并计算可执行文件 SHA-256" />
                    <Button Style="{DynamicResource ToolButton}" Content="恢复默认"
                            Command="{Binding RestoreDefaultCommand}" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- ============ 统计卡片 ============ -->
        <UniformGrid Grid.Row="1" Columns="6" Margin="0,0,0,16">
            <Border Style="{DynamicResource Card}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="系统启动项" Style="{DynamicResource SecondaryText}" />
                    <TextBlock Text="{Binding SystemCount}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{DynamicResource Card}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="第三方启动项" Style="{DynamicResource SecondaryText}" />
                    <TextBlock Text="{Binding AppCount}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{DynamicResource Card}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="驱动启动项" Style="{DynamicResource SecondaryText}" />
                    <TextBlock Text="{Binding DriverCount}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{DynamicResource Card}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="未知启动项" Style="{DynamicResource SecondaryText}" />
                    <TextBlock Text="{Binding UnknownCount}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{DynamicResource Card}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="预计可优化启动时间" Style="{DynamicResource SecondaryText}" />
                    <TextBlock Text="{Binding OptimizableText}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{DynamicResource Card}">
                <StackPanel>
                    <TextBlock Text="AI 综合建议" Style="{DynamicResource SecondaryText}" />
                    <TextBlock Text="{Binding AiSummary}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ============ 主区：分类树 + 列表 + 详情 ============ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{DynamicResource Card}" Margin="0,0,16,0">
                <StackPanel>
                    <TextBlock Text="来源分类" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Style="{DynamicResource NavItem}"
                                             IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=RadioButton}, Mode=OneWay}"
                                             Click="OnCategoryClick">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Icon}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Style="{DynamicResource BodyText}"
                                                   TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12" />
                                        <Border Grid.Column="2" Style="{DynamicResource Badge}">
                                            <TextBlock Text="{Binding Count}" Foreground="{DynamicResource PrimaryBrush}" FontSize="11" />
                                        </Border>
                                    </Grid>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{DynamicResource SecondaryText}" Margin="4,12,0,0" TextWrapping="Wrap"
                               Text="系统类默认折叠且受保护；用户软件为主管理区，支持批量启停。" />
                </StackPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{DynamicResource Card}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 批量选择头：三态全选 + 取消全选/反选 + 勾选批量栏 -->
                        <Grid Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox Style="{DynamicResource CheckBoxFluent}" IsThreeState="True"
                                          IsChecked="{Binding Selection.SelectAllState, Mode=OneWay}"
                                          Click="OnSelectAllClick" VerticalAlignment="Center" />
                                <TextBlock Text="全选" Style="{DynamicResource BodyText}" VerticalAlignment="Center" Margin="4,0,12,0" />
                                <Button Style="{DynamicResource ToolButton}" Content="取消全选"
                                        Command="{Binding Selection.DeselectAllCommand}" Margin="0,0,6,0" />
                                <Button Style="{DynamicResource ToolButton}" Content="反选"
                                        Command="{Binding Selection.InvertSelectionCommand}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Visibility="{Binding Selection.HasChecked, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding Selection.CheckedCount, StringFormat=已选 {0} 项}"
                                           Style="{DynamicResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <Button Style="{DynamicResource SecondaryButton}" Content="批量禁用"
                                        Command="{Binding DisableSelectedCommand}" Margin="0,0,6,0" />
                                <Button Style="{DynamicResource SecondaryButton}" Content="批量启用"
                                        Command="{Binding EnableSelectedCommand}" Margin="0,0,6,0" />
                                <Button Style="{DynamicResource ToolButton}" Content="导出 CSV"
                                        Command="{Binding ExportCsvCommand}" />
                            </StackPanel>
                        </Grid>

                        <ScrollViewer Grid.Row="1">
                        <ListBox ItemsSource="{Binding ItemsView}" SelectedItem="{Binding SelectedItem}"
                                 Style="{DynamicResource FluentListBox}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition Width="1.6*" />
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="50" />
                                            <ColumnDefinition Width="2*" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" Style="{DynamicResource CheckBoxFluent}" />
                                        <Image Grid.Column="1" Source="{Binding Icon}" Width="18" Height="18" VerticalAlignment="Center">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                        <TextBlock Grid.Column="2" Text="{Binding Detail.Item.Name}" Style="{DynamicResource BodyText}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3" Text="{Binding Detail.Item.Publisher, TargetNullValue=—}"
                                                   Style="{DynamicResource SecondaryText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <Border Grid.Column="4" Style="{DynamicResource Badge}" VerticalAlignment="Center"
                                                Background="{Binding KindBrushKey, Converter={StaticResource RiskToBrush}}">
                                            <TextBlock Text="{Binding KindText}" Foreground="#FFFFFF" FontSize="10" />
                                        </Border>
                                        <TextBlock Grid.Column="5" Text="{Binding SignatureVerificationText}" Style="{DynamicResource SecondaryText}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="6" Text="{Binding StarsText}" Foreground="{DynamicResource WarningBrush}"
                                                   VerticalAlignment="Center" FontSize="11" />
                                        <TextBlock Grid.Column="7" Text="{Binding ImpactLevelText}" Style="{DynamicResource SecondaryText}"
                                                   VerticalAlignment="Center" />
                                        <ToggleButton Grid.Column="8" Style="{DynamicResource ToggleSwitch}"
                                                      IsChecked="{Binding Detail.Item.Enabled, Mode=OneWay}"
                                                      Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="9" Text="{Binding Detail.Advice}" Style="{DynamicResource SecondaryText}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="11" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{DynamicResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ScrollViewer Grid.Column="0">
                            <StackPanel DataContext="{Binding SelectedItem.Detail, TargetNullValue=隐藏}">
                                <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}">
                                    <Run Text="{Binding Item.Name, TargetNullValue=选中启动项查看详情}" />
                                </TextBlock>
                                <TextBlock Style="{DynamicResource SecondaryText}" Margin="0,4,0,0" TextWrapping="Wrap">
                                    <Run Text="路径：" /><Run Text="{Binding FilePath, TargetNullValue=—}" />
                                </TextBlock>
                                <TextBlock Style="{DynamicResource SecondaryText}" TextWrapping="Wrap">
                                    <Run Text="位置：" /><Run Text="{Binding Item.Location}" /><Run Text=" / " /><Run Text="{Binding Item.Kind}" />
                                </TextBlock>
                                <TextBlock Style="{DynamicResource SecondaryText}" TextWrapping="Wrap">
                                    <Run Text="签名：" /><Run Text="{Binding Signature.SignerSubject, TargetNullValue=—}" />
                                </TextBlock>
                                <TextBlock Style="{DynamicResource SecondaryText}" TextWrapping="Wrap">
                                    <Run Text="SHA256：" /><Run Text="{Binding Sha256, TargetNullValue=—}" />
                                </TextBlock>
                                <TextBlock Style="{DynamicResource SecondaryText}" TextWrapping="Wrap">
                                    <Run Text="分类依据：" /><Run Text="{Binding Classification.Reasons[0], TargetNullValue=—}" />
                                </TextBlock>
                                <TextBlock Style="{DynamicResource SecondaryText}" TextWrapping="Wrap">
                                    <Run Text="修改时间：" /><Run Text="{Binding ModifiedUtc, StringFormat={}{0:yyyy-MM-dd HH:mm}, TargetNullValue=—}" />
                                </TextBlock>
                                <TextBlock Style="{DynamicResource SecondaryText}" TextWrapping="Wrap">
                                    <Run Text="影响估算（估计值）：CPU " /><Run Text="{Binding Impact.CpuEstimate}" />
                                    <Run Text="% · 磁盘 " /><Run Text="{Binding Impact.DiskEstimateMB}" />
                                    <Run Text=" MB · 内存 " /><Run Text="{Binding Impact.MemoryEstimateMB}" />
                                    <Run Text=" MB · 启动 " /><Run Text="{Binding Impact.TimeEstimateSeconds}" /><Run Text=" s" />
                                </TextBlock>
                            </StackPanel>
                        </ScrollViewer>

                        <UniformGrid Grid.Column="1" Columns="3">
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Text="启动时间分析(s)" Style="{DynamicResource SecondaryText}" HorizontalAlignment="Center" />
                                <controls:BarChartControl Points="{Binding DataContext.TimePoints, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </StackPanel>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Text="CPU 影响估算(%)" Style="{DynamicResource SecondaryText}" HorizontalAlignment="Center" />
                                <controls:BarChartControl Points="{Binding DataContext.CpuPoints, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </StackPanel>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Text="内存影响估算(MB)" Style="{DynamicResource SecondaryText}" HorizontalAlignment="Center" />
                                <controls:BarChartControl Points="{Binding DataContext.MemoryPoints, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </StackPanel>
                        </UniformGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
