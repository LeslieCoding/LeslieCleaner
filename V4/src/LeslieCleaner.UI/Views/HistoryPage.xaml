<UserControl x:Class="LeslieCleaner.UI.Views.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LeslieCleaner.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:HistoryViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ 顶部操作栏 ============ -->
        <Border Grid.Row="0" Style="{DynamicResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <StackPanel>
                    <TextBlock Text="历史记录中心" Style="{DynamicResource PageTitle}" FontSize="18" />
                    <TextBlock Text="{Binding StatusText}" Style="{DynamicResource SecondaryText}" Margin="0,4,0,0"
                               AutomationProperties.LiveSetting="Assertive" />
                </StackPanel>
                <WrapPanel HorizontalAlignment="Left" Margin="0,12,0,0">
                    <TextBox Style="{DynamicResource InputBox}" Width="200"
                             Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="关键词搜索" />
                    <ComboBox Width="120" Height="36" Margin="8,0" VerticalContentAlignment="Center"
                              SelectedValue="{Binding FilterModule}" ToolTip="按模块筛选">
                        <ComboBoxItem Content="全部模块" />
                        <ComboBox ItemsSource="{Binding ModuleCounts}"
                                  DisplayMemberPath="Key" SelectedValuePath="Key"
                                  SelectedValue="{Binding FilterModule}" />
                    </ComboBox>
                    <CheckBox Content="信息" IsChecked="{Binding ShowInfo}" Style="{DynamicResource CheckBoxFluent}" VerticalAlignment="Center" Margin="10,0,8,0" />
                    <CheckBox Content="警告" IsChecked="{Binding ShowWarning}" Style="{DynamicResource CheckBoxFluent}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <CheckBox Content="错误" IsChecked="{Binding ShowError}" Style="{DynamicResource CheckBoxFluent}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button Style="{DynamicResource SecondaryButton}" Content="刷新"
                            Command="{Binding LoadLogsCommand}" Margin="0,0,8,0" />
                    <Button Style="{DynamicResource ToolButton}" Content="清理旧记录 (&lt;=500)"
                            Command="{Binding PruneLogsCommand}" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- ============ 统计卡片 ============ -->
        <UniformGrid Grid.Row="1" Columns="{Binding ModuleCounts.Count}" Margin="0,0,0,16">
            <UniformGrid.Style>
                <Style TargetType="UniformGrid">
                    <Setter Property="Columns" Value="2" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ModuleCounts.Count}" Value="0">
                            <Setter Property="Columns" Value="1" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ModuleCounts.Count}" Value="3">
                            <Setter Property="Columns" Value="3" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </UniformGrid.Style>
        </UniformGrid>

        <!-- ============ 操作日志列表 ============ -->
        <Border Grid.Row="2" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Separator Grid.Column="0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                    <TextBlock Style="{DynamicResource SecondaryText}" Margin="0,0,12,0">
                        <Run Text="显示第 " /><Run Text="{Binding CurrentPage}" /><Run Text=" 页" />
                    </TextBlock>
                    <TextBlock Style="{DynamicResource SecondaryText}">
                        <Run Text="共 " /><Run Text="{Binding TotalRecords}" /><Run Text=" 条记录" />
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{DynamicResource Card}" Margin="0,0,0,0">
            <DataGrid ItemsSource="{Binding Logs}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      Background="{DynamicResource CardBrush}"
                      BorderBrush="{DynamicResource DividerBrush}"
                      BorderThickness="0">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Padding" Value="8,4" />
                        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
                    </Style>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Padding" Value="4" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="时间" Binding="{Binding TimeDisplay}" Width="Auto" />
                    <DataGridTextColumn Header="模块" Binding="{Binding Module}" Width="100" />
                    <DataGridTextColumn Header="操作" Binding="{Binding Operation}" Width="120" />
                    <DataGridTextColumn Header="描述" Binding="{Binding Description}" Width="300" />
                    <DataGridTemplateColumn Header="级别" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{DynamicResource Badge}"
                                        Background="{Binding LevelBrushKey, Converter={StaticResource RiskToBrush}}">
                                    <TextBlock Text="{Binding LevelDisplay}" Foreground="#FFFFFF" FontSize="10" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="结果" Binding="{Binding Result}" Width="100" />
                    <DataGridTextColumn Header="错误信息" Binding="{Binding ErrorMessage}" Width="200" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ============ 分页控件 ============ -->
        <Border Grid.Row="4" Style="{DynamicResource Card}" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Style="{DynamicResource SecondaryButton}" Content="上一页"
                        Command="{Binding LoadPreviousPageCommand}"
                        IsEnabled="{Binding CurrentPage, Converter={StaticResource GreaterThanConverter}, ConverterParameter=1}"
                        Margin="0,0,8,0" />
                <TextBlock Style="{DynamicResource BodyText}" VerticalAlignment="Center" Margin="8,0">
                    <Run Text="第 " /><Run Text="{Binding CurrentPage}" /><Run Text=" 页" />
                </TextBlock>
                <Button Style="{DynamicResource SecondaryButton}" Content="下一页"
                        Command="{Binding LoadNextPageCommand}"
                        Margin="8,0,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
