<UserControl x:Class="LeslieCleaner.UI.Views.SmartScanPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LeslieCleaner.UI.Controls"
             xmlns:vm="clr-namespace:LeslieCleaner.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SmartScanViewModel}">

    <Grid>
        <!-- ============ 就绪态 ============ -->
        <StackPanel Visibility="{Binding State, Converter={StaticResource EqualityToVisibility}, ConverterParameter=Ready}"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
            <controls:LineIcon Kind="zap" Width="48" Height="48" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="Smart Scan" Style="{DynamicResource PageTitle}" HorizontalAlignment="Center" Margin="0,12,0,4" />
            <TextBlock Text="临时文件 / 更新缓存 / 缩略图 / 日志 / 转储 / Prefetch / 回收站 / 注册表 / 浏览器 / GPU / 字体 / DX / AI 工具"
                       Style="{DynamicResource SecondaryText}" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="560" TextAlignment="Center" />
            <Button Style="{DynamicResource PrimaryButton}" Width="220" Content="开始扫描"
                    Command="{Binding StartScanCommand}" Margin="0,20,0,0" />
        </StackPanel>

        <!-- ============ 扫描中 ============ -->
        <StackPanel Visibility="{Binding State, Converter={StaticResource EqualityToVisibility}, ConverterParameter=Scanning}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="640">
            <TextBlock Text="正在扫描…" Style="{DynamicResource PageTitle}" FontSize="20" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding CurrentPath}" Style="{DynamicResource SecondaryText}" Margin="0,8,0,12"
                       TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
            <ProgressBar Style="{DynamicResource FluentProgressBar}" Width="480"
                         Value="{Binding ProgressPercent}" Maximum="100" IsIndeterminate="{Binding IsPaused}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                <Button Style="{DynamicResource SecondaryButton}" Width="120" Content="暂停/继续"
                        Command="{Binding TogglePauseCommand}" Margin="0,0,12,0" />
                <Button Style="{DynamicResource DangerButton}" Width="120" Height="36" Content="取消"
                        Command="{Binding CancelScanCommand}" />
            </StackPanel>
        </StackPanel>

        <!-- ============ 结果页 ============ -->
        <Grid Visibility="{Binding State, Converter={StaticResource EqualityToVisibility}, ConverterParameter=Results}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{DynamicResource Card}" Margin="0,0,0,16">
                <StackPanel VerticalAlignment="Center">
                    <controls:DonutChart Slices="{Binding DonutSlices}" Height="180" />
                    <TextBlock Text="{Binding TotalFoundText}" Style="{DynamicResource BodyText}" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,12,0,0" TextWrapping="Wrap" TextAlignment="Center" />
                    <Button Style="{DynamicResource PrimaryButton}" Content="一键清理"
                            Command="{Binding CleanCommand}" Margin="0,16,0,0" />
                    <Button Style="{DynamicResource SecondaryButton}" Content="重新扫描"
                            Command="{Binding StartScanCommand}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{DynamicResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding StatusText}" Style="{DynamicResource SecondaryText}" />

                    <!-- 批量选择头：三态全选 + 取消全选/反选 + 勾选批量栏 -->
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox Style="{DynamicResource CheckBoxFluent}" IsThreeState="True"
                                      IsChecked="{Binding Selection.SelectAllState, Mode=OneWay}"
                                      Click="OnSelectAllClick" VerticalAlignment="Center" />
                            <TextBlock Text="全选" Style="{DynamicResource BodyText}" VerticalAlignment="Center" Margin="4,0,12,0" />
                            <Button Style="{DynamicResource ToolButton}" Content="取消全选"
                                    Command="{Binding Selection.DeselectAllCommand}" Margin="0,0,6,0" />
                            <Button Style="{DynamicResource ToolButton}" Content="反选"
                                    Command="{Binding Selection.InvertSelectionCommand}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Visibility="{Binding Selection.HasChecked, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding Selection.CheckedCount, StringFormat=已选 {0} 类}"
                                       Style="{DynamicResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Button Style="{DynamicResource PrimaryButton}" Content="清理勾选"
                                    Command="{Binding CleanCommand}" />
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="2" Margin="0,8,0,0">
                        <ItemsControl ItemsSource="{Binding Categories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,7" AutomationProperties.Name="{Binding DisplayName}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="70" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked}" Style="{DynamicResource CheckBoxFluent}" />
                                        <StackPanel Grid.Column="1" Margin="8,0,10,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" Style="{DynamicResource BodyText}" />
                                            <TextBlock Text="{Binding MeasurementDetails}" Style="{DynamicResource SecondaryText}"
                                                       TextWrapping="Wrap" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding SizeBytes, Converter={StaticResource BytesToString}}"
                                                   Style="{DynamicResource SecondaryText}" VerticalAlignment="Center" TextAlignment="Right" />
                                        <TextBlock Grid.Column="3" Text="{Binding FileCount, StringFormat={}{0} 项}"
                                                   Style="{DynamicResource SecondaryText}" VerticalAlignment="Center" TextAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ============ 清理中 ============ -->
        <StackPanel Visibility="{Binding State, Converter={StaticResource EqualityToVisibility}, ConverterParameter=Cleaning}"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="正在清理（文件进隔离区，注册表先备份）…" Style="{DynamicResource PageTitle}" FontSize="18" />
            <ProgressBar Style="{DynamicResource FluentProgressBar}" Width="480" IsIndeterminate="True" Margin="0,16,0,0" />
        </StackPanel>

        <!-- ============ 完成页：实际释放、逐项失败、复扫剩余 ============ -->
        <ScrollViewer Visibility="{Binding State, Converter={StaticResource EqualityToVisibility}, ConverterParameter=Done}"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border Style="{DynamicResource Card}" MaxWidth="820" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock HorizontalAlignment="Center" FontSize="42" AutomationProperties.Name="清理结果状态">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="✓" />
                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasCleanIssues}" Value="True">
                                        <Setter Property="Text" Value="!" />
                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding CleanResultTitle}" Style="{DynamicResource PageTitle}" FontSize="20"
                               HorizontalAlignment="Center" Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Center" />
                    <TextBlock Text="{Binding CleanResultText}" Style="{DynamicResource BodyText}"
                               HorizontalAlignment="Center" Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Center" />
                    <Border Background="{DynamicResource PrimarySoftBrush}" CornerRadius="10" Padding="12" Margin="0,14,0,0">
                        <TextBlock Text="{Binding PostCleanVerificationText}" Style="{DynamicResource BodyText}"
                                   TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
                    </Border>
                    <Border BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,12,0,0"
                            Visibility="{Binding HasCleanIssues, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="未完成项目与原因" Style="{DynamicResource SectionTitle}" FontSize="16" />
                            <TextBlock Text="{Binding CleanFailureSummary}" Style="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,5,0,8" />
                            <ListBox ItemsSource="{Binding CleanFailures}" Style="{DynamicResource FluentListBox}" MaxHeight="260"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="清理失败项目列表">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,5" AutomationProperties.Name="{Binding Reason}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Path}" Style="{DynamicResource BodyText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                                <TextBlock Style="{DynamicResource SecondaryText}" TextWrapping="Wrap"><Run Text="原因："/><Run Text="{Binding Reason}"/></TextBlock>
                                                <TextBlock Style="{DynamicResource SecondaryText}" TextWrapping="Wrap"><Run Text="下一步："/><Run Text="{Binding Guidance}"/></TextBlock>
                                            </StackPanel>
                                            <Border Grid.Column="1" Style="{DynamicResource Badge}" Margin="12,0,0,0" VerticalAlignment="Center"
                                                    Visibility="{Binding RequiresElevation, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="需要管理员权限" Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>
                    <WrapPanel HorizontalAlignment="Center" Margin="0,20,0,0">
                        <Button Style="{DynamicResource SecondaryButton}" Content="回滚清理"
                                Command="{Binding RollbackCommand}" Margin="0,0,12,8"
                                Visibility="{Binding CanRollback, Converter={StaticResource BoolToVisibility}}" />
                        <Button Style="{DynamicResource PrimaryButton}" Content="再次扫描确认"
                                Command="{Binding StartScanCommand}" Margin="0,0,0,8" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
