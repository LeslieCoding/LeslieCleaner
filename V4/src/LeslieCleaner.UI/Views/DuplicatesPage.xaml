<UserControl x:Class="LeslieCleaner.UI.Views.DuplicatesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LeslieCleaner.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DuplicatesViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{DynamicResource Card}" Margin="0,0,0,16">
            <Grid>
                <StackPanel>
                    <TextBlock Text="重复文件查找" Style="{DynamicResource PageTitle}" FontSize="18" />
                    <TextBlock Text="{Binding StatusText}" Style="{DynamicResource SecondaryText}" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding ProgressText}" Style="{DynamicResource SecondaryText}"
                               TextTrimming="CharacterEllipsis" />
                    <ProgressBar Style="{DynamicResource FluentProgressBar}" Height="4" Margin="0,6,0,0"
                                 Value="{Binding ProgressPercent}" Maximum="100"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ComboBox Width="160" Height="36" VerticalContentAlignment="Center"
                              ItemsSource="{Binding Policies}" SelectedItem="{Binding SelectedPolicy}"
                              ToolTip="智能保留规则" />
                    <Button Style="{DynamicResource PrimaryButton}" Content="扫描"
                            Command="{Binding ScanCommand}" Margin="8,0" />
                    <Button Style="{DynamicResource DangerButton}" Content="批量清理"
                            Command="{Binding DeleteRedundantCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{DynamicResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 批量选择头：三态全选 + 取消全选/反选 + 勾选批量栏 -->
                <Grid Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox Style="{DynamicResource CheckBoxFluent}" IsThreeState="True"
                                  IsChecked="{Binding Selection.SelectAllState, Mode=OneWay}"
                                  Click="OnSelectAllClick" VerticalAlignment="Center" />
                        <TextBlock Text="全选" Style="{DynamicResource BodyText}" VerticalAlignment="Center" Margin="4,0,12,0" />
                        <Button Style="{DynamicResource ToolButton}" Content="取消全选"
                                Command="{Binding Selection.DeselectAllCommand}" Margin="0,0,6,0" />
                        <Button Style="{DynamicResource ToolButton}" Content="反选"
                                Command="{Binding Selection.InvertSelectionCommand}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Visibility="{Binding Selection.HasChecked, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding Selection.CheckedCount, StringFormat=已选 {0} 组}"
                                   Style="{DynamicResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Button Style="{DynamicResource DangerButton}" Content="批量删除冗余"
                                Command="{Binding DeleteRedundantCommand}" />
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="1">
                <ListBox ItemsSource="{Binding Groups}" Style="{DynamicResource FluentListBox}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{DynamicResource CardInteractive}" Margin="0,0,0,10" Padding="12">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked}" Style="{DynamicResource CheckBoxFluent}"
                                                  VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Style="{DynamicResource BodyText}" FontWeight="SemiBold" Margin="8,0,0,0">
                                            <Run Text="{Binding Group.Files.Count, StringFormat={}{0} 个相同文件, Mode=OneWay}" />
                                            <Run Text=" · 哈希 " />
                                            <Run Text="{Binding HashPreview, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Grid.Column="2" Style="{DynamicResource SecondaryText}">
                                            <Run Text="可释放 " /><Run Text="{Binding SizeText, Mode=OneWay}" />
                                        </TextBlock>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Group.Files}" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Style="{DynamicResource SecondaryText}"
                                                           TextTrimming="CharacterEllipsis" Margin="0,1" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
