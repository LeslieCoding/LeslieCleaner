<UserControl x:Class="LeslieCleaner.UI.Views.LargeFilesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LeslieCleaner.UI.Controls"
             xmlns:vm="clr-namespace:LeslieCleaner.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:LargeFilesViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{DynamicResource Card}" Margin="0,0,0,16">
            <Grid>
                <StackPanel>
                    <TextBlock Text="大文件分析" Style="{DynamicResource PageTitle}" FontSize="18" />
                    <TextBlock Text="{Binding StatusText}" Style="{DynamicResource SecondaryText}" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding CurrentPath}" Style="{DynamicResource SecondaryText}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{DynamicResource PrimaryButton}" Content="开始分析"
                            Command="{Binding AnalyzeCommand}" Margin="0,0,8,0" />
                    <Button Style="{DynamicResource SecondaryButton}" Content="暂停/继续"
                            Command="{Binding TogglePauseCommand}" Margin="0,0,8,0" />
                    <Button Style="{DynamicResource DangerButton}" Content="取消" Height="36"
                            Command="{Binding CancelCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{DynamicResource Card}" Margin="0,0,16,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="空间占用 Treemap" Style="{DynamicResource SecondaryText}" />
                    <controls:TreemapControl Grid.Row="1" Roots="{Binding TreemapRoots}" Margin="0,8,0,0" />
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{DynamicResource Card}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Top 100 大文件" Style="{DynamicResource SecondaryText}" />

                        <!-- 批量选择头：三态全选 + 取消全选/反选 + 勾选批量栏 -->
                        <Grid Grid.Row="1" Margin="0,6,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox Style="{DynamicResource CheckBoxFluent}" IsThreeState="True"
                                          IsChecked="{Binding Selection.SelectAllState, Mode=OneWay}"
                                          Click="OnSelectAllClick" VerticalAlignment="Center" />
                                <TextBlock Text="全选" Style="{DynamicResource BodyText}" VerticalAlignment="Center" Margin="4,0,12,0" />
                                <Button Style="{DynamicResource ToolButton}" Content="取消全选"
                                        Command="{Binding Selection.DeselectAllCommand}" Margin="0,0,6,0" />
                                <Button Style="{DynamicResource ToolButton}" Content="反选"
                                        Command="{Binding Selection.InvertSelectionCommand}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Visibility="{Binding Selection.HasChecked, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding Selection.CheckedCount, StringFormat=已选 {0} 项}"
                                           Style="{DynamicResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <Button Style="{DynamicResource SecondaryButton}" Content="导出 CSV"
                                        Command="{Binding ExportCsvCommand}" />
                            </StackPanel>
                        </Grid>

                        <ScrollViewer Grid.Row="2" Margin="0,6,0,0">
                            <ListBox ItemsSource="{Binding TopFiles}" Style="{DynamicResource FluentListBox}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="80" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked}" Style="{DynamicResource CheckBoxFluent}"
                                                      VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding Entry.Path}" Style="{DynamicResource BodyText}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="{Binding Entry.SizeBytes, Converter={StaticResource BytesToString}}"
                                                       Style="{DynamicResource SecondaryText}" TextAlignment="Right" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{DynamicResource Card}">
                    <StackPanel>
                        <TextBlock Text="清理建议（规则引擎）" Style="{DynamicResource SecondaryText}" />
                        <ItemsControl ItemsSource="{Binding Suggestions}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="{DynamicResource WarningBrush}"
                                               TextWrapping="Wrap" FontSize="12" Margin="0,3" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
