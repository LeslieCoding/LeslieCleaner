<UserControl x:Class="LeslieCleaner.UI.Views.RegistryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LeslieCleaner.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:RegistryViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{DynamicResource Card}" Margin="0,0,0,16">
            <Grid>
                <StackPanel>
                    <TextBlock Text="注册表清理" Style="{DynamicResource PageTitle}" FontSize="18" />
                    <TextBlock Text="{Binding StatusText}" Style="{DynamicResource SecondaryText}" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding SummaryText}" Foreground="{DynamicResource WarningBrush}"
                               FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{DynamicResource PrimaryButton}" Content="扫描"
                            Command="{Binding ScanCommand}" Margin="0,0,8,0" />
                    <Button Style="{DynamicResource SecondaryButton}" Content="修复勾选项"
                            Command="{Binding FixCommand}" Margin="0,0,8,0" />
                    <Button Style="{DynamicResource SecondaryButton}" Content="备份列表"
                            Command="{Binding LoadBackupsCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{DynamicResource Card}" Margin="0,0,16,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 批量选择头：三态全选 + 取消全选/反选 + 勾选批量栏 -->
                    <Grid Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox Style="{DynamicResource CheckBoxFluent}" IsThreeState="True"
                                      IsChecked="{Binding Selection.SelectAllState, Mode=OneWay}"
                                      Click="OnSelectAllClick" VerticalAlignment="Center" />
                            <TextBlock Text="全选" Style="{DynamicResource BodyText}" VerticalAlignment="Center" Margin="4,0,12,0" />
                            <Button Style="{DynamicResource ToolButton}" Content="取消全选"
                                    Command="{Binding Selection.DeselectAllCommand}" Margin="0,0,6,0" />
                            <Button Style="{DynamicResource ToolButton}" Content="反选"
                                    Command="{Binding Selection.InvertSelectionCommand}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Visibility="{Binding Selection.HasChecked, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding Selection.CheckedCount, StringFormat=已选 {0} 项}"
                                       Style="{DynamicResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Button Style="{DynamicResource PrimaryButton}" Content="批量修复"
                                    Command="{Binding FixCommand}" Margin="0,0,6,0" />
                            <Button Style="{DynamicResource SecondaryButton}" Content="导出 CSV"
                                    Command="{Binding ExportCsvCommand}" />
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1">
                        <ListBox ItemsSource="{Binding Findings}" Style="{DynamicResource FluentListBox}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="70" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked}" Style="{DynamicResource CheckBoxFluent}" />
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding Finding.Description}" Style="{DynamicResource BodyText}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Finding.KeyPath}" Style="{DynamicResource SecondaryText}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Style="{DynamicResource Badge}"
                                            Background="{Binding Finding.Risk, Converter={StaticResource RiskToBrush}}"
                                            VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding Finding.Risk}" Foreground="#FFFFFF" FontSize="11"
                                                   HorizontalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{DynamicResource Card}">
                <StackPanel>
                    <TextBlock Text="注册表备份（一键恢复）" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" />
                    <ScrollViewer Margin="0,8,0,0">
                        <ListBox ItemsSource="{Binding Backups}" Style="{DynamicResource FluentListBox}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding RegistryKeyPath}" Style="{DynamicResource BodyText}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding CreatedUtc, StringFormat={}{0:MM-dd HH:mm}}"
                                                       Style="{DynamicResource SecondaryText}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{DynamicResource ToolButton}" Content="恢复"
                                                Command="{Binding DataContext.RestoreBackupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
