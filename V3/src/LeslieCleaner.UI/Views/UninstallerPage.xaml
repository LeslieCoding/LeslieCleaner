<UserControl x:Class="LeslieCleaner.UI.Views.UninstallerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LeslieCleaner.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:UninstallerViewModel}">
    <Grid>
        <!-- ============ 程序列表 ============ -->
        <Grid Visibility="{Binding State, Converter={StaticResource EqualityToVisibility}, ConverterParameter=List}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{DynamicResource Card}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="智能卸载" Style="{DynamicResource PageTitle}" FontSize="18" />
                        <TextBlock Text="{Binding SummaryText}" Style="{DynamicResource SecondaryText}" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding StatusText}" Style="{DynamicResource SecondaryText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox Style="{DynamicResource InputBox}" Width="240"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="搜索名称/发布者" />
                        <Button Style="{DynamicResource SecondaryButton}" Content="刷新"
                                Command="{Binding LoadCommand}" Margin="8,0" />
                        <Button Style="{DynamicResource DangerButton}" Content="卸载勾选"
                                Command="{Binding UninstallSelectedCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{DynamicResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 批量选择头：三态全选 + 取消全选/反选 + 勾选批量栏 -->
                    <Grid Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox Style="{DynamicResource CheckBoxFluent}" IsThreeState="True"
                                      IsChecked="{Binding Selection.SelectAllState, Mode=OneWay}"
                                      Click="OnSelectAllClick" VerticalAlignment="Center" />
                            <TextBlock Text="全选" Style="{DynamicResource BodyText}" VerticalAlignment="Center" Margin="4,0,12,0" />
                            <Button Style="{DynamicResource ToolButton}" Content="取消全选"
                                    Command="{Binding Selection.DeselectAllCommand}" Margin="0,0,6,0" />
                            <Button Style="{DynamicResource ToolButton}" Content="反选"
                                    Command="{Binding Selection.InvertSelectionCommand}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Visibility="{Binding Selection.HasChecked, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding Selection.CheckedCount, StringFormat=已选 {0} 个}"
                                       Style="{DynamicResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Button Style="{DynamicResource DangerButton}" Content="批量卸载"
                                    Command="{Binding UninstallSelectedCommand}" Margin="0,0,6,0" />
                            <Button Style="{DynamicResource SecondaryButton}" Content="导出 CSV"
                                    Command="{Binding ExportCsvCommand}" />
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1">
                    <ListBox ItemsSource="{Binding AppsView}" Style="{DynamicResource FluentListBox}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" Style="{DynamicResource CheckBoxFluent}" />
                                    <TextBlock Grid.Column="1" Text="{Binding App.Name}" Style="{DynamicResource BodyText}"
                                               VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding App.Publisher, TargetNullValue=—}"
                                               Style="{DynamicResource SecondaryText}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" Text="{Binding App.SizeBytes, Converter={StaticResource BytesToString}}"
                                               Style="{DynamicResource SecondaryText}" VerticalAlignment="Center" TextAlignment="Right" />
                                    <TextBlock Grid.Column="4" Text="{Binding App.InstallDate, StringFormat={}{0:yyyy-MM-dd}, TargetNullValue=—}"
                                               Style="{DynamicResource SecondaryText}" VerticalAlignment="Center" TextAlignment="Right" />
                                    <Border Grid.Column="5" Style="{DynamicResource Badge}" VerticalAlignment="Center"
                                            HorizontalAlignment="Right" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding App.Source}" Foreground="{DynamicResource PrimaryBrush}" FontSize="11" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ============ 卸载执行中 ============ -->
        <StackPanel Visibility="{Binding State, Converter={StaticResource EqualityToVisibility}, ConverterParameter=Uninstalling}"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="{Binding WizardText}" Style="{DynamicResource PageTitle}" FontSize="18"
                       TextWrapping="Wrap" TextAlignment="Center" />
            <ProgressBar Style="{DynamicResource FluentProgressBar}" Width="480" IsIndeterminate="True" Margin="0,16,0,0" />
            <Button Style="{DynamicResource DangerButton}" Content="取消" Width="120" Height="36"
                    Command="{Binding CancelUninstallCommand}" Margin="0,16,0,0" />
        </StackPanel>

        <!-- ============ 残留结果 ============ -->
        <Grid Visibility="{Binding State, Converter={StaticResource EqualityToVisibility}, ConverterParameter=Residuals}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{DynamicResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="残留扫描结果" Style="{DynamicResource PageTitle}" FontSize="18" />
                    <TextBlock Text="{Binding ResidualSummary}" Style="{DynamicResource SecondaryText}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{DynamicResource Card}" Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 批量选择头：三态全选 + 取消全选/反选（高置信度默认勾选） -->
                    <Grid Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox Style="{DynamicResource CheckBoxFluent}" IsThreeState="True"
                                      IsChecked="{Binding ResidualSelection.SelectAllState, Mode=OneWay}"
                                      Click="OnResidualSelectAllClick" VerticalAlignment="Center" />
                            <TextBlock Text="全选" Style="{DynamicResource BodyText}" VerticalAlignment="Center" Margin="4,0,12,0" />
                            <Button Style="{DynamicResource ToolButton}" Content="取消全选"
                                    Command="{Binding ResidualSelection.DeselectAllCommand}" Margin="0,0,6,0" />
                            <Button Style="{DynamicResource ToolButton}" Content="反选"
                                    Command="{Binding ResidualSelection.InvertSelectionCommand}" />
                        </StackPanel>
                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding ResidualSelection.CheckedCount, StringFormat=已选 {0} 项}"
                                   Style="{DynamicResource SecondaryText}"
                                   Visibility="{Binding ResidualSelection.HasChecked, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>

                    <ScrollViewer Grid.Row="1">
                    <ListBox ItemsSource="{Binding Residuals}" Style="{DynamicResource FluentListBox}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked}" Style="{DynamicResource CheckBoxFluent}" />
                                    <Border Grid.Column="1" Style="{DynamicResource Badge}" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding KindText}" Foreground="{DynamicResource PrimaryBrush}" FontSize="11" />
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding Item.Path}" Style="{DynamicResource BodyText}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" Text="{Binding Item.SizeBytes, Converter={StaticResource BytesToString}}"
                                               Style="{DynamicResource SecondaryText}" VerticalAlignment="Center" TextAlignment="Right" />
                                    <TextBlock Grid.Column="4" Text="{Binding ConfidenceText}" Foreground="{DynamicResource WarningBrush}"
                                               VerticalAlignment="Center" TextAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
                </Grid>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{DynamicResource SecondaryButton}" Content="返回列表"
                        Command="{Binding BackToListCommand}" Margin="0,0,12,0" />
                <Button Style="{DynamicResource DangerButton}" Content="清理残留"
                        Command="{Binding CleanResidualsCommand}" />
            </StackPanel>
        </Grid>

        <!-- ============ 完成 ============ -->
        <StackPanel Visibility="{Binding State, Converter={StaticResource EqualityToVisibility}, ConverterParameter=Done}"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="✓" FontSize="48" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding ResidualSummary}" Style="{DynamicResource PageTitle}" FontSize="16"
                       HorizontalAlignment="Center" Margin="0,12,0,0" TextWrapping="Wrap" TextAlignment="Center" />
            <Button Style="{DynamicResource PrimaryButton}" Content="返回程序列表" Width="200"
                    Command="{Binding BackToListCommand}" Margin="0,20,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
