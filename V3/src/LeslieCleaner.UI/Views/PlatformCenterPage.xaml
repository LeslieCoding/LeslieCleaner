<UserControl x:Class="LeslieCleaner.UI.Views.PlatformCenterPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LeslieCleaner.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PlatformCenterViewModel}">
    <ScrollViewer>
        <StackPanel>
            <Border Style="{DynamicResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="平台中心" Style="{DynamicResource PageTitle}" FontSize="18" />
                    <TextBlock Text="AI 维护建议、插件信任校验与安全更新检查" Style="{DynamicResource SecondaryText}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <UniformGrid Columns="2">
                <Border Style="{DynamicResource Card}" Margin="0,0,8,16">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="插件管理" Style="{DynamicResource BodyText}" FontWeight="SemiBold" />
                            <Button HorizontalAlignment="Right" Style="{DynamicResource ToolButton}" Content="刷新并校验" Command="{Binding RefreshPluginsCommand}" />
                        </Grid>
                        <TextBlock Text="{Binding PluginStatus}" Style="{DynamicResource SecondaryText}" Margin="0,6,0,0" />
                        <ListBox ItemsSource="{Binding Plugins}" Style="{DynamicResource FluentListBox}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="{Binding Name}" Style="{DynamicResource BodyText}"/><TextBlock Text="{Binding Detail}" Style="{DynamicResource SecondaryText}" TextTrimming="CharacterEllipsis"/></StackPanel>
                                        <Button Grid.Column="1" Content="启用/禁用" Style="{DynamicResource ToolButton}" Command="{Binding DataContext.TogglePluginCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource Card}" Margin="8,0,0,16">
                    <StackPanel>
                        <Grid><TextBlock Text="安全更新" Style="{DynamicResource BodyText}" FontWeight="SemiBold"/><Button HorizontalAlignment="Right" Content="检查更新" Style="{DynamicResource ToolButton}" Command="{Binding CheckUpdatesCommand}"/></Grid>
                        <TextBlock Text="{Binding UpdateStatus}" Style="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <Separator Margin="0,16"/>
                        <Grid><TextBlock Text="安全状态" Style="{DynamicResource BodyText}" FontWeight="SemiBold"/><Button HorizontalAlignment="Right" Content="重新评估" Style="{DynamicResource ToolButton}" Command="{Binding RefreshSecurityCommand}"/></Grid>
                        <TextBlock Text="{Binding SecurityStatus}" Style="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource Card}" Margin="0,0,8,0">
                    <StackPanel><Grid><TextBlock Text="AI 维护计划" Style="{DynamicResource BodyText}" FontWeight="SemiBold"/><Button HorizontalAlignment="Right" Content="刷新" Style="{DynamicResource ToolButton}" Command="{Binding LoadAiPlansCommand}"/></Grid>
                        <ListBox ItemsSource="{Binding AiPlans}" Style="{DynamicResource FluentListBox}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,4"><TextBlock Text="{Binding Name}" Style="{DynamicResource BodyText}"/><TextBlock Text="{Binding ModuleIds}" Style="{DynamicResource SecondaryText}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ListBox>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
