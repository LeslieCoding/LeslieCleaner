<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 深色主题（按新色系校准：#111827 底，层级与浅色一一对应） -->
    <Color x:Key="PrimaryColor">#3B82F6</Color>
    <Color x:Key="PrimaryHoverColor">#60A5FA</Color>
    <Color x:Key="PrimarySoftColor">#1E3A5F</Color>
    <Color x:Key="SuccessColor">#22C55E</Color>
    <Color x:Key="WarningColor">#F97316</Color>
    <Color x:Key="DangerColor">#EF4444</Color>

    <Color x:Key="BackgroundColor">#111827</Color>
    <Color x:Key="ContentColor">#1C2533</Color>
    <Color x:Key="SecondaryBackgroundColor">#16202E</Color>
    <Color x:Key="NavColor">#0F1722</Color>
    <Color x:Key="HoverColor">#243144</Color>
    <Color x:Key="DividerColor">#2B3648</Color>
    <Color x:Key="BorderColor">#2E3A4E</Color>
    <Color x:Key="SelectedColor">#1E3A5F</Color>
    <Color x:Key="TrackColor">#2B3648</Color>
    <Color x:Key="ShadowColor">#000000</Color>

    <Color x:Key="TextColor">#F3F4F6</Color>
    <Color x:Key="TextSecondaryColor">#D1D5DB</Color>
    <Color x:Key="TextHintColor">#9CA3AF</Color>
    <Color x:Key="TextDisabledColor">#6B7280</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}" />
    <SolidColorBrush x:Key="PrimarySoftBrush" Color="{StaticResource PrimarySoftColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource ContentColor}" />
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="{StaticResource SecondaryBackgroundColor}" />
    <SolidColorBrush x:Key="NavBrush" Color="{StaticResource NavColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextHintBrush" Color="{StaticResource TextHintColor}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}" />
    <SolidColorBrush x:Key="SelectedBrush" Color="{StaticResource SelectedColor}" />
    <SolidColorBrush x:Key="TrackBrush" Color="{StaticResource TrackColor}" />
</ResourceDictionary>
