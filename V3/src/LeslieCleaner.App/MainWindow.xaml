<Window x:Class="LeslieCleaner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:LeslieCleaner.UI.Controls;assembly=LeslieCleaner.UI"
        xmlns:vm="clr-namespace:LeslieCleaner.UI.ViewModels;assembly=LeslieCleaner.UI"
        Title="LeslieCleaner"
        Width="1280" Height="800" MinWidth="1024" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}">
    <Window.InputBindings>
        <KeyBinding Key="K" Modifiers="Ctrl" Command="ApplicationCommands.Find" />
    </Window.InputBindings>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ 左侧导航（纯白 260px，细线条图标） ============ -->
        <Border Grid.Column="0" Background="{DynamicResource NavBrush}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                    <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource PrimaryBrush}">
                        <TextBlock Text="L" Foreground="#FFFFFF" FontWeight="Bold" FontSize="16"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="LeslieCleaner" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <ItemsControl ItemsSource="{Binding NavigationItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Style="{DynamicResource NavItem}"
                                             GroupName="Nav"
                                             Click="OnNavItemClick"
                                             AutomationProperties.Name="{Binding Title}">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:LineIcon Kind="{Binding Icon}" Width="18" Height="18"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                           VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Grid.Row="2" Text="AI Powered Windows Optimization"
                           Style="{DynamicResource SecondaryText}" Margin="20,10" />
            </Grid>
        </Border>

        <!-- ============ 右侧：TopBar 60px + 内容 ============ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="60" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource NavBrush}"
                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="24,0">
                    <TextBlock Text="{Binding SelectedItem.Title}" Style="{DynamicResource PageTitle}"
                               VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Width="260" Height="36" CornerRadius="10"
                                Background="{DynamicResource SecondaryBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                                <controls:LineIcon Kind="search" Width="14" Height="14"
                                                   Foreground="{DynamicResource TextDisabledBrush}" />
                                <TextBox x:Name="GlobalSearchBox" Background="Transparent" BorderThickness="0"
                                         VerticalContentAlignment="Center" Width="220" Margin="8,0,0,0"
                                         Foreground="{DynamicResource TextBrush}"
                                         CaretBrush="{DynamicResource TextBrush}"
                                         GotFocus="OnTopSearchFocus"
                                         AutomationProperties.Name="全局搜索（Ctrl+K）"
                                         ToolTip="全局搜索（Ctrl+K）" />
                            </StackPanel>
                        </Border>
                        <Grid Margin="12,0,0,0">
                            <Button x:Name="AdminRestartButton" Style="{DynamicResource SecondaryButton}"
                                    Content="⚑ 管理员模式" Height="32" Padding="10,0"
                                    ToolTip="以管理员身份重新启动（注册表/服务/计划任务操作需要）"
                                    Click="OnAdminRestartClick"
                                    AutomationProperties.Name="以管理员身份重新启动" />
                        </Grid>
                        <Grid Margin="12,0,0,0">
                            <Button Style="{DynamicResource ToolButton}" Width="36" Padding="0"
                                    ToolTip="通知中心" Click="OnNotificationBellClick"
                                    AutomationProperties.Name="通知中心">
                                <controls:LineIcon Kind="bell" Width="18" Height="18"
                                                   Foreground="{DynamicResource TextHintBrush}" />
                            </Button>
                            <Border x:Name="UnreadBadge" Width="16" Height="16" CornerRadius="8"
                                    Background="{DynamicResource DangerBrush}"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0"
                                    IsHitTestVisible="False" Visibility="Collapsed">
                                <TextBlock x:Name="UnreadBadgeText" Text="0" Foreground="#FFFFFF" FontSize="9"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <Button Style="{DynamicResource ToolButton}" Width="36" Padding="0"
                                ToolTip="设置" Click="OnSettingsClick" AutomationProperties.Name="设置">
                            <controls:LineIcon Kind="settings" Width="18" Height="18"
                                               Foreground="{DynamicResource TextHintBrush}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" Margin="24" />
        </Grid>

        <!-- ============ 通知中心弹层（右上卡片） ============ -->
        <Border x:Name="NotificationPanel" Grid.Column="1" Visibility="Collapsed"
                Style="{DynamicResource Card}" Width="380" MaxHeight="480" Padding="16"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,66,18,0"
                Panel.ZIndex="90" Effect="{StaticResource CardShadowLevel3}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="通知中心" Style="{DynamicResource PageTitle}" FontSize="15" />
                    <Button HorizontalAlignment="Right" Style="{DynamicResource ToolButton}" Content="全部已读"
                            Click="OnMarkAllReadClick" AutomationProperties.Name="全部已读" />
                </Grid>
                <ScrollViewer Grid.Row="1" Margin="0,8,0,0">
                    <ListBox x:Name="NotificationList" Style="{DynamicResource FluentListBox}"
                             AutomationProperties.Name="通知列表">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4">
                                    <TextBlock Text="{Binding Title}" Style="{DynamicResource BodyText}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Body}" Style="{DynamicResource SecondaryText}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Local, StringFormat={}{0:MM-dd HH:mm}}"
                                               Style="{DynamicResource SecondaryText}" FontSize="10" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ============ 全局搜索弹层（Ctrl+K） ============ -->
        <Grid x:Name="SearchOverlay" Grid.ColumnSpan="2" Visibility="Collapsed"
              Background="#66000000" Panel.ZIndex="95" PreviewMouseLeftButtonDown="OnSearchOverlayBackdrop">
            <Border Style="{DynamicResource Card}" Width="520" Padding="16"
                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,120,0,0"
                    Effect="{StaticResource CardShadowLevel3}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBox x:Name="SearchInput" Style="{DynamicResource InputBox}"
                             TextChanged="OnSearchTextChanged" PreviewKeyDown="OnSearchInputKeyDown"
                             AutomationProperties.Name="搜索功能、设置、软件、建议"
                             ToolTip="输入关键词：功能模块 / 设置项 / 已安装软件 / AI 建议" />
                    <ListBox x:Name="SearchResults" Grid.Row="1" Margin="0,10,0,0" MaxHeight="320"
                             Style="{DynamicResource FluentListBox}"
                             PreviewKeyDown="OnSearchInputKeyDown"
                             MouseDoubleClick="OnSearchResultActivate"
                             AutomationProperties.Name="搜索结果">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{DynamicResource Badge}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Kind}" Foreground="{DynamicResource PrimaryBrush}" FontSize="10" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding Title}" Style="{DynamicResource BodyText}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Detail}" Style="{DynamicResource SecondaryText}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- ============ 确认对话框遮罩 ============ -->
        <Grid x:Name="DialogOverlay" Grid.ColumnSpan="2" Visibility="Collapsed"
              Background="#66000000" Panel.ZIndex="100">
            <Border Style="{DynamicResource Card}" Width="440" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Effect="{StaticResource CardShadowLevel3}">
                <StackPanel>
                    <TextBlock x:Name="DialogTitle" Style="{DynamicResource PageTitle}" FontSize="18" />
                    <TextBlock x:Name="DialogMessage" Style="{DynamicResource BodyText}"
                               TextWrapping="Wrap" Margin="0,12,0,20" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="DialogCancelButton" Style="{DynamicResource SecondaryButton}"
                                Content="取消" Margin="0,0,12,0" Click="OnDialogCancel"
                                AutomationProperties.Name="取消" />
                        <Button x:Name="DialogConfirmButton" Style="{DynamicResource PrimaryButton}"
                                Content="确认" Click="OnDialogConfirm"
                                AutomationProperties.Name="确认" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
